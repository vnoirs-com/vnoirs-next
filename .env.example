# Resend API Key (obtain from https://resend.com/api-keys)
RESEND_API_KEY=re_123456789_placeholder

# Email configuration
# Once you verify your domain at resend.com/domains, set CONTACT_FROM_EMAIL to contact@vnoirs.com or noreply@vnoirs.com
# For testing before verification, use onboarding@resend.dev
CONTACT_FROM_EMAIL=Vnoirs <onboarding@resend.dev>

# Recipient email where contact form submissions will be sent
CONTACT_TO_EMAIL=cs@vnoirs.com

# Site URL for canonical URLs and SEO metadata
NEXT_PUBLIC_SITE_URL=https://vnoirs.com

# Google Drive Internal CV Upload Configuration
# Option 1: Direct Google Apps Script Webhook URL (creates files in target drive folder)
GOOGLE_DRIVE_UPLOAD_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec

# Option 2: Google Drive API Service Account credentials & Folder ID
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Supabase Configuration (When ready to replace mock data)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
